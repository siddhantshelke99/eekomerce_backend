generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  SUPER_ADMIN
  CORPORATE_BUYER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COLLECTED
  EXPIRED
  CANCELLED
}

enum RequestStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum AuctionStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  LOCAL_DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(CUSTOMER)
  googleId            String?   @unique
  companyName         String?
  gstin               String?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions            Session[]
  stores              Store[]
  reservations        Reservation[]
  productRequests     ProductRequest[]
  orders              Order[]
  permissions         UserPermission[]
  auditLogs           AuditLog[]
  corporateAuctions   CorporateAuction[]
  auctionBids         AuctionBid[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  createdAt   DateTime @default(now())

  users       UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model CorporateAuction {
  id           String        @id @default(uuid())
  buyerId      String
  categoryId   String
  title        String
  description  String?
  imageUrl     String?
  referenceUrl String?
  quantity     Int
  targetBudget Float?
  latitude     Float         @default(12.9784)
  longitude    Float         @default(77.6408)
  radiusKm     Float         @default(25.0)
  status       AuctionStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  buyer        User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  bids         AuctionBid[]

  @@map("corporate_auctions")
}

model AuctionBid {
  id            String           @id @default(uuid())
  auctionId     String
  vendorId      String
  storeId       String
  unitPrice     Float
  lotTotalPrice Float
  deliveryDays  Int              @default(2)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  auction       CorporateAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  vendor        User             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([auctionId, storeId])
  @@map("auction_bids")
}

model Store {
  id               String   @id @default(uuid())
  ownerId          String
  name             String
  slug             String   @unique
  description      String?
  address          String
  latitude         Float
  longitude        Float
  radiusKm         Float    @default(5.0)
  phone            String
  email            String?
  isVerified       Boolean  @default(false)
  openingTime      String   @default("09:00")
  closingTime      String   @default("21:00")
  supportsPickup   Boolean  @default(true)
  supportsDelivery Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  inventoryItems   InventoryItem[]
  reservations     Reservation[]
  vendorQuotes     VendorQuote[]
  orders           Order[]
  auctionBids      AuctionBid[]

  @@map("stores")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products          Product[]
  productRequests   ProductRequest[]
  corporateAuctions CorporateAuction[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  slug        String   @unique
  brand       String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  inventoryItems InventoryItem[]

  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  sku         String   @unique
  variantName String
  color       String?
  size        String?
  modelNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@map("product_variants")
}

model InventoryItem {
  id               String          @id @default(uuid())
  storeId          String
  productId        String
  variantId        String?
  localPrice       Float
  comparePrice     Float?
  stockQuantity    Int             @default(0)
  isAvailable      Boolean         @default(true)
  activeOffer      String?
  lastStockUpdate  DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reservations     Reservation[]
  orderItems       OrderItem[]

  @@unique([storeId, productId, variantId])
  @@map("inventory_items")
}

model Reservation {
  id              String            @id @default(uuid())
  reservationCode String            @unique
  userId          String
  storeId         String
  inventoryItemId String
  quantity        Int               @default(1)
  status          ReservationStatus @default(CONFIRMED)
  expiresAt       DateTime
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model ProductRequest {
  id          String        @id @default(uuid())
  userId      String
  categoryId  String
  title       String
  description String?
  imageUrl    String?
  externalUrl String?
  latitude    Float
  longitude   Float
  radiusKm    Float         @default(5.0)
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id])
  quotes      VendorQuote[]

  @@map("product_requests")
}

model VendorQuote {
  id                String         @id @default(uuid())
  requestId         String
  storeId           String
  isAvailable       Boolean        @default(true)
  offeredPrice      Float?
  availableQuantity Int?           @default(1)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  productRequest    ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([requestId, storeId])
  @@map("vendor_quotes")
}

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  userId          String
  storeId         String
  fulfillmentType FulfillmentType @default(PICKUP)
  deliveryAddress String?
  deliveryFee     Float           @default(0)
  totalAmount     Float
  status          OrderStatus     @default(CONFIRMED)
  paymentStatus   PaymentStatus   @default(PAID)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  inventoryItemId String
  unitPrice       Float
  quantity        Int           @default(1)

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model DemandMetric {
  id          String   @id @default(uuid())
  queryText   String
  categoryId  String?
  latitude    Float
  longitude   Float
  searchCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("demand_metrics")
}
